# Example environment file
# Copy to .env and update with your values

# ====================================
# DJANGO BACKEND CONFIGURATION
# ====================================
DEBUG=False
SECRET_KEY=your-secret-key-change-this-in-production-12345678901234567890
ALLOWED_HOSTS=your-domain.com,backend
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=erp_password_123
DB_HOST=localhost
DB_PORT=5432
# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-this-12345678901234567890
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE=52428800

# ====================================
# REACT FRONTEND CONFIGURATION
# ====================================
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=

# ====================================
# DOCKER CONFIGURATION
# ====================================
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_123
POSTGRES_DB=erp_db
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
FRONTEND_PORT=8080

# ====================================
# APPLICATION CONFIGURATION
# ====================================
APP_NAME=Electric Service ERP
APP_VERSION=1.0.0
ENVIRONMENT=production
TIMEZONE=Asia/Kolkata
